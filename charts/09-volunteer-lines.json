{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart: volunteers and interns reported by BSBCC each year, 2021-2025.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/bsbcc-participation-2021-2025.json"
  },
  "padding": {
    "right": 20
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelColor": "#1f2d2a"
      }
    },
    "y": {
      "field": "people",
      "type": "quantitative",
      "title": "People",
      "scale": {
        "domain": [
          0,
          65
        ]
      },
      "axis": {
        "tickCount": 4
      }
    },
    "color": {
      "field": "programme",
      "type": "nominal",
      "scale": {
        "domain": [
          "Volunteers",
          "Interns"
        ],
        "range": [
          "#1f2d2a",
          "#7a766b"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "title": null,
        "symbolType": "stroke",
        "symbolStrokeWidth": 3,
        "symbolSize": 700,
        "labelFontSize": 13,
        "columnPadding": 24
      }
    },
    "tooltip": [
      {
        "field": "programme",
        "title": "Programme"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "people",
        "type": "quantitative",
        "title": "People"
      },
      {
        "field": "note",
        "title": "Note"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "strokeDash": {
          "field": "programme",
          "type": "nominal",
          "scale": {
            "domain": [
              "Volunteers",
              "Interns"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                4
              ]
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "symbolType": "stroke",
            "symbolStrokeWidth": 3,
            "symbolSize": 700,
            "labelFontSize": 13,
            "columnPadding": 24
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 1
      },
      "encoding": {
        "shape": {
          "condition": {
            "test": "datum.programme == 'Interns'",
            "value": "square"
          },
          "value": "circle"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.programme == 'Volunteers'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "people"
        },
        "color": {
          "value": "#1f2d2a"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.programme == 'Interns'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 17,
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "people"
        },
        "color": {
          "value": "#1f2d2a"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "dy": 4,
        "fontSize": 14,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "programme"
        },
        "color": {
          "value": "#1f2d2a"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2021,
            "people": 60
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": -8,
        "fontSize": 12,
        "fontStyle": "italic",
        "lineHeight": 15,
        "color": "#56625d",
        "text": [
          "2021 report also mentions",
          "2 remote volunteers;",
          "unclear if among the 7"
        ]
      },
      "encoding": {
        "color": {
          "value": "#56625d"
        },
        "tooltip": null
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
