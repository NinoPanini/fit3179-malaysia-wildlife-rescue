{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: the selected animal group's share of each state's 2024 handovers, in fixed classes.",
  "width": "container",
  "height": 470,
  "params": [
    {
      "name": "groupChoice",
      "value": "Mammals",
      "bind": {
        "input": "select",
        "options": [
          "Mammals",
          "Reptiles",
          "Birds"
        ],
        "name": "Show the share that were: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d9d6cc",
        "stroke": "#fbf9f2",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "Territory"
          },
          {
            "field": "note",
            "type": "nominal",
            "title": "Note"
          }
        ]
      },
      "transform": [
        {
          "calculate": "'Federal Territories: one combined figure, not split by territory'",
          "as": "note"
        }
      ]
    },
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "data/handovers-2024.json"
            },
            "key": "state",
            "fields": [
              "reptiles",
              "mammals",
              "birds",
              "total"
            ]
          }
        },
        {
          "filter": "isValid(datum.total)"
        },
        {
          "calculate": "(groupChoice == 'Mammals' ? datum.mammals : groupChoice == 'Reptiles' ? datum.reptiles : datum.birds) / datum.total",
          "as": "share"
        },
        {
          "calculate": "groupChoice == 'Mammals' ? datum.mammals : groupChoice == 'Reptiles' ? datum.reptiles : datum.birds",
          "as": "count"
        },
        {
          "calculate": "groupChoice == 'Mammals' ? (datum.share < 0.02 ? 0 : datum.share < 0.04 ? 1 : datum.share < 0.07 ? 2 : datum.share < 0.1 ? 3 : datum.share < 0.25 ? 4 : 5) : groupChoice == 'Reptiles' ? (datum.share < 0.5 ? 0 : datum.share < 0.9 ? 1 : datum.share < 0.93 ? 2 : datum.share < 0.96 ? 3 : datum.share < 0.98 ? 4 : 5) : (datum.share < 0.005 ? 0 : datum.share < 0.01 ? 1 : datum.share < 0.015 ? 2 : datum.share < 0.02 ? 3 : datum.share < 0.03 ? 4 : 5)",
          "as": "cls"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fbf9f2",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "cls",
          "type": "ordinal",
          "title": "Share of the state’s handovers (classes change with the group)",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4,
              5
            ],
            "range": [
              "#ffffcc",
              "#c7e9b4",
              "#7fcdbb",
              "#41b6c4",
              "#2c7fb8",
              "#253494"
            ]
          },
          "legend": {
            "labelExpr": "(groupChoice == 'Mammals' ? [\"under 2%\", \"2%\\u20134%\", \"4%\\u20137%\", \"7%\\u201310%\", \"10%\\u201325%\", \"25% or more\"] : groupChoice == 'Reptiles' ? [\"under 50%\", \"50%\\u201390%\", \"90%\\u201393%\", \"93%\\u201396%\", \"96%\\u201398%\", \"98% or more\"] : [\"under 0.5%\", \"0.5%\\u20131%\", \"1%\\u20131.5%\", \"1.5%\\u20132%\", \"2%\\u20133%\", \"3% or more\"])[datum.value]",
            "orient": "bottom-left",
            "direction": "vertical",
            "title": [
              "Share of the",
              "state’s handovers"
            ],
            "symbolType": "square",
            "symbolSize": 220,
            "symbolStrokeColor": "#9c9686",
            "symbolStrokeWidth": 0.5,
            "labelLimit": 160,
            "titleLimit": 420,
            "columnPadding": 14
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of handovers",
            "format": ".1%"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Animals in this group",
            "format": ","
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "All animals handed over",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state-anchors.json"
      },
      "transform": [
        {
          "calculate": "(groupChoice == 'Mammals' ? datum.mammals : groupChoice == 'Reptiles' ? datum.reptiles : datum.birds) / datum.total",
          "as": "share"
        },
        {
          "calculate": "groupChoice == 'Mammals' ? (datum.share < 0.02 ? 0 : datum.share < 0.04 ? 1 : datum.share < 0.07 ? 2 : datum.share < 0.1 ? 3 : datum.share < 0.25 ? 4 : 5) : groupChoice == 'Reptiles' ? (datum.share < 0.5 ? 0 : datum.share < 0.9 ? 1 : datum.share < 0.93 ? 2 : datum.share < 0.96 ? 3 : datum.share < 0.98 ? 4 : 5) : (datum.share < 0.005 ? 0 : datum.share < 0.01 ? 1 : datum.share < 0.015 ? 2 : datum.share < 0.02 ? 3 : datum.share < 0.03 ? 4 : 5)",
          "as": "cls"
        },
        {
          "calculate": "datum.share < 0.1 ? format(datum.share, '.1%') : format(datum.share, '.0%')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.cls >= 4",
            "value": "white"
          },
          "value": "#1f2d2a"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share",
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
