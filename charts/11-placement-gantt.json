{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Gantt chart of 57 volunteer placements at BSBCC in 2025 (two half-year panels), linked to a histogram of placement length. Drag across either timeline to select placements that started in that period.",
  "usermeta": {
    "fitWidth": 1010
  },
  "data": {
    "url": "data/bsbcc-placements-2025.json"
  },
  "params": [
    {
      "name": "brush",
      "select": {
        "type": "interval",
        "encodings": [
          "x"
        ]
      },
      "views": [
        "firstHalf",
        "secondHalf"
      ]
    }
  ],
  "hconcat": [
    {
      "vconcat": [
        {
          "name": "firstHalf",
          "width": 620,
          "height": {
            "step": 11
          },
          "title": {
            "text": "Started January–June",
            "anchor": "start",
            "fontSize": 14,
            "color": "#1f2d2a",
            "offset": 4
          },
          "transform": [
            {
              "filter": {
                "field": "start",
                "gte": {
                  "year": 2025,
                  "month": 1,
                  "date": 1
                }
              }
            },
            {
              "filter": {
                "field": "start",
                "lt": {
                  "year": 2025,
                  "month": 7,
                  "date": 1
                }
              }
            }
          ],
          "mark": {
            "type": "bar",
            "height": 8,
            "cornerRadius": 1.5
          },
          "encoding": {
            "y": {
              "field": "placement",
              "type": "nominal",
              "sort": {
                "field": "start"
              },
              "title": null,
              "axis": {
                "labels": false,
                "ticks": false,
                "domain": false,
                "grid": true,
                "gridColor": "#efece2"
              }
            },
            "x": {
              "field": "start",
              "type": "temporal",
              "title": null,
              "scale": {
                "domainMin": {
                  "year": 2025,
                  "month": 1,
                  "date": 1
                },
                "domainMax": {
                  "year": 2025,
                  "month": 7,
                  "date": 17
                }
              },
              "axis": {
                "format": "%b",
                "tickCount": {
                  "interval": "month"
                },
                "orient": "top",
                "labelColor": "#1f2d2a",
                "labelFontSize": 13
              }
            },
            "x2": {
              "field": "end"
            },
            "color": {
              "field": "origin_group",
              "type": "nominal",
              "title": "Volunteer from",
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#2f4858",
                  "#8a8270"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal"
              }
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "Listed origin"
              },
              {
                "field": "start",
                "type": "temporal",
                "title": "Start",
                "format": "%d %b %Y"
              },
              {
                "field": "end",
                "type": "temporal",
                "title": "End",
                "format": "%d %b %Y"
              },
              {
                "field": "days",
                "type": "quantitative",
                "title": "Days on site"
              }
            ]
          }
        },
        {
          "name": "secondHalf",
          "width": 620,
          "height": {
            "step": 11
          },
          "title": {
            "text": "Started July–December",
            "anchor": "start",
            "fontSize": 14,
            "color": "#1f2d2a",
            "offset": 4
          },
          "transform": [
            {
              "filter": {
                "field": "start",
                "gte": {
                  "year": 2025,
                  "month": 7,
                  "date": 1
                }
              }
            },
            {
              "filter": {
                "field": "start",
                "lt": {
                  "year": 2026,
                  "month": 1,
                  "date": 1
                }
              }
            }
          ],
          "mark": {
            "type": "bar",
            "height": 8,
            "cornerRadius": 1.5
          },
          "encoding": {
            "y": {
              "field": "placement",
              "type": "nominal",
              "sort": {
                "field": "start"
              },
              "title": null,
              "axis": {
                "labels": false,
                "ticks": false,
                "domain": false,
                "grid": true,
                "gridColor": "#efece2"
              }
            },
            "x": {
              "field": "start",
              "type": "temporal",
              "title": null,
              "scale": {
                "domainMin": {
                  "year": 2025,
                  "month": 7,
                  "date": 1
                },
                "domainMax": {
                  "year": 2026,
                  "month": 1,
                  "date": 14
                }
              },
              "axis": {
                "format": "%b",
                "tickCount": {
                  "interval": "month"
                },
                "orient": "top",
                "labelColor": "#1f2d2a",
                "labelFontSize": 13
              }
            },
            "x2": {
              "field": "end"
            },
            "color": {
              "field": "origin_group",
              "type": "nominal",
              "title": "Volunteer from",
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#2f4858",
                  "#8a8270"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal"
              }
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "Listed origin"
              },
              {
                "field": "start",
                "type": "temporal",
                "title": "Start",
                "format": "%d %b %Y"
              },
              {
                "field": "end",
                "type": "temporal",
                "title": "End",
                "format": "%d %b %Y"
              },
              {
                "field": "days",
                "type": "quantitative",
                "title": "Days on site"
              }
            ]
          }
        }
      ],
      "spacing": 22,
      "resolve": {
        "scale": {
          "x": "independent"
        }
      }
    },
    {
      "width": 290,
      "height": 250,
      "layer": [
        {
          "transform": [
            {
              "filter": {
                "param": "brush"
              }
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                },
                {
                  "op": "sum",
                  "field": "days",
                  "as": "d"
                },
                {
                  "op": "median",
                  "field": "days",
                  "as": "m"
                }
              ]
            },
            {
              "calculate": "[(length(data('brush_store')) ? 'Selected: ' : 'All: ') + datum.n + (datum.n == 1 ? ' placement' : ' placements'), format(datum.d, ',') + ' total placement-days', 'Median stay: ' + datum.m + ' days']",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 14,
            "fontWeight": 700,
            "lineHeight": 19,
            "color": "#1f2d2a"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": -78
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "bin": {
                "step": 7,
                "extent": [
                  8,
                  43
                ],
                "nice": false
              },
              "field": "days",
              "as": [
                "bin_start",
                "bin_end"
              ]
            },
            {
              "calculate": "datum.bin_start + '–' + (datum.bin_end - 1)",
              "as": "range"
            }
          ],
          "mark": {
            "type": "bar",
            "fill": "#fbf9f2",
            "stroke": "#3e5260",
            "strokeWidth": 1.5,
            "strokeDash": [
              3,
              2
            ]
          },
          "encoding": {
            "x": {
              "field": "range",
              "type": "ordinal",
              "scale": {
                "domain": [
                  "8–14",
                  "15–21",
                  "22–28",
                  "29–35",
                  "36–42"
                ]
              },
              "title": "Length of stay (days on site)",
              "axis": {
                "labelAngle": 0
              }
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative",
              "title": "Placements",
              "scale": {
                "domain": [
                  0,
                  45
                ]
              },
              "axis": {
                "tickCount": 5
              }
            }
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "brush"
              }
            },
            {
              "bin": {
                "step": 7,
                "extent": [
                  8,
                  43
                ],
                "nice": false
              },
              "field": "days",
              "as": [
                "bin_start",
                "bin_end"
              ]
            },
            {
              "calculate": "datum.bin_start + '–' + (datum.bin_end - 1)",
              "as": "range"
            }
          ],
          "mark": {
            "type": "bar",
            "color": "#2f4858",
            "stroke": "#fbf9f2",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "range",
              "type": "ordinal",
              "scale": {
                "domain": [
                  "8–14",
                  "15–21",
                  "22–28",
                  "29–35",
                  "36–42"
                ]
              },
              "title": "Length of stay (days on site)",
              "axis": {
                "labelAngle": 0
              }
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "range",
                "title": "Days on site"
              },
              {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Placements"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "range": "8–14",
                "n": 38
              }
            ]
          },
          "mark": {
            "type": "text",
            "text": "38 of 57 stayed two weeks or less",
            "align": "left",
            "dx": -16,
            "dy": -8,
            "baseline": "bottom",
            "color": "#1f2d2a",
            "fontSize": 12.5,
            "fontWeight": 600
          },
          "encoding": {
            "x": {
              "field": "range",
              "type": "ordinal"
            },
            "y": {
              "field": "n",
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ],
  "spacing": 36,
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
