{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Gantt chart of 57 volunteer placements at BSBCC in 2025, linked to a histogram of placement length. Drag across the timeline to select placements that started in that period.",
  "usermeta": {
    "fitWidth": 1010
  },
  "data": {
    "url": "data/bsbcc-placements-2025.json"
  },
  "hconcat": [
    {
      "width": 620,
      "height": 627,
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          }
        }
      ],
      "mark": {
        "type": "bar",
        "height": 7,
        "cornerRadius": 1.5
      },
      "encoding": {
        "y": {
          "field": "placement",
          "type": "nominal",
          "sort": {
            "field": "start"
          },
          "title": null,
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": true,
            "gridColor": "#efece2"
          }
        },
        "x": {
          "field": "start",
          "type": "temporal",
          "title": null,
          "scale": {
            "nice": "month"
          },
          "axis": {
            "format": "%b",
            "tickCount": {
              "interval": "month"
            },
            "orient": "top",
            "labelColor": "#1f2d2a",
            "labelFontSize": 13
          }
        },
        "x2": {
          "field": "end"
        },
        "color": {
          "field": "origin_group",
          "type": "nominal",
          "title": "Volunteer from",
          "scale": {
            "domain": [
              "Malaysia",
              "Other countries"
            ],
            "range": [
              "#2f4858",
              "#8a8270"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "offset": 26
          }
        },
        "tooltip": [
          {
            "field": "origin",
            "title": "Listed origin"
          },
          {
            "field": "start",
            "type": "temporal",
            "title": "Start",
            "format": "%d %b %Y"
          },
          {
            "field": "end",
            "type": "temporal",
            "title": "End",
            "format": "%d %b %Y"
          },
          {
            "field": "days",
            "type": "quantitative",
            "title": "Days on site"
          }
        ]
      }
    },
    {
      "width": 290,
      "height": 250,
      "layer": [
        {
          "transform": [
            {
              "filter": {
                "param": "brush"
              }
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                },
                {
                  "op": "sum",
                  "field": "days",
                  "as": "d"
                }
              ]
            },
            {
              "calculate": "(length(data('brush_store')) ? 'Selected: ' : 'All: ') + datum.n + (datum.n == 1 ? ' placement' : ' placements') + ' · ' + format(datum.d, ',') + ' days on site'",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "fontSize": 14,
            "fontWeight": 700,
            "color": "#1f2d2a"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": -16
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "bin": {
                "step": 7,
                "extent": [
                  7,
                  42
                ]
              },
              "field": "days",
              "as": [
                "bin_start",
                "bin_end"
              ]
            }
          ],
          "mark": {
            "type": "bar",
            "fill": "#fbf9f2",
            "stroke": "#3e5260",
            "strokeWidth": 1.5,
            "strokeDash": [
              3,
              2
            ]
          },
          "encoding": {
            "x": {
              "field": "bin_start",
              "type": "quantitative",
              "scale": {
                "domain": [
                  7,
                  42
                ]
              },
              "title": "Length of stay (days on site)",
              "axis": {
                "values": [
                  7,
                  14,
                  21,
                  28,
                  35,
                  42
                ]
              }
            },
            "x2": {
              "field": "bin_end"
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative",
              "title": "Placements",
              "scale": {
                "domain": [
                  0,
                  26
                ]
              },
              "axis": {
                "tickCount": 5
              }
            }
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "brush"
              }
            },
            {
              "bin": {
                "step": 7,
                "extent": [
                  7,
                  42
                ]
              },
              "field": "days",
              "as": [
                "bin_start",
                "bin_end"
              ]
            },
            {
              "calculate": "datum.bin_start + '–' + (datum.bin_end - 1) + ' days'",
              "as": "range"
            }
          ],
          "mark": {
            "type": "bar",
            "color": "#2f4858",
            "stroke": "#fbf9f2",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "bin_start",
              "type": "quantitative",
              "scale": {
                "domain": [
                  7,
                  42
                ]
              },
              "title": "Length of stay (days on site)",
              "axis": {
                "values": [
                  7,
                  14,
                  21,
                  28,
                  35,
                  42
                ]
              }
            },
            "x2": {
              "field": "bin_end"
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "range",
                "title": "Placement length"
              },
              {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Placements"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 14
              }
            ]
          },
          "encoding": {
            "x": {
              "field": "d",
              "type": "quantitative"
            }
          },
          "layer": [
            {
              "mark": {
                "type": "rule",
                "color": "#1f2d2a",
                "strokeDash": [
                  5,
                  4
                ],
                "strokeWidth": 2
              }
            },
            {
              "mark": {
                "type": "text",
                "text": "Half stayed 14 days or less",
                "align": "left",
                "dx": 6,
                "dy": 4,
                "baseline": "top",
                "color": "#1f2d2a",
                "fontSize": 12.5,
                "fontWeight": 600
              },
              "encoding": {
                "y": {
                  "value": 0
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "spacing": 36,
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
