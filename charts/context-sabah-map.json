{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Locator map of Sabah showing BSBCC at Sepilok and Tabin Wildlife Reserve.",
  "width": 280,
  "height": 190,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/borneo-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.state == 'Sabah'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e3ddc9",
        "stroke": "#fbf9f2",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 116.55,
            "latitude": 5.45,
            "t": "SABAH"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "letterSpacing": 2,
        "color": "#56625d",
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "url": "data/sabah-places.json"
      },
      "mark": {
        "type": "circle",
        "size": 70,
        "color": "#1f2d2a",
        "stroke": "#fbf9f2",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "place",
            "title": "Place"
          },
          {
            "field": "role",
            "title": "Role"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/sabah-places.json"
      },
      "transform": [
        {
          "filter": "datum.place == 'BSBCC, Sepilok'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "place"
        }
      }
    },
    {
      "data": {
        "url": "data/sabah-places.json"
      },
      "transform": [
        {
          "filter": "datum.place != 'BSBCC, Sepilok'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 10,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "place"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
