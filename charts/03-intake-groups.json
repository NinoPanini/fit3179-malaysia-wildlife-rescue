{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 180,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "domain": false,
      "gridColor": "#e2e7de",
      "tickColor": "#bac8bc",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "padding": 16
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#243c32"
    },
    "range": {
      "category": [
        "#225b43",
        "#b26130",
        "#628ba3",
        "#7d6b97",
        "#8f9547",
        "#9c6970"
      ]
    }
  },
  "data": {
    "url": "data/nwrc-intake-2024.json"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "animals",
          "as": "animals"
        }
      ],
      "groupby": [
        "group"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Reptiles",
        "Birds",
        "Mammals"
      ],
      "axis": {
        "title": null
      }
    },
    "x": {
      "field": "animals",
      "type": "quantitative",
      "title": "Animals received",
      "scale": {
        "domain": [
          0,
          12500
        ]
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Reptiles",
          "Birds",
          "Mammals"
        ],
        "range": [
          "#225b43",
          "#6387a0",
          "#b26130"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "Animal group"
      },
      {
        "field": "animals",
        "type": "quantitative",
        "title": "Animals received",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 25,
        "cornerRadiusEnd": 3
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "color": "#243c32",
        "fontSize": 14
      },
      "encoding": {
        "text": {
          "field": "animals",
          "format": ","
        },
        "color": {
          "value": "#243c32"
        }
      }
    }
  ]
}