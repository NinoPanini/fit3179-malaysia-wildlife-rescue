{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart of the change in animals handed over in each state from 2021 to 2024, sorted; each bar is labelled with the change and both counts.",
  "width": "container",
  "height": 480,
  "padding": 10,
  "data": {
    "url": "data/handovers-trend.json"
  },
  "transform": [
    {
      "filter": "datum.year == 2021 || datum.year == 2024"
    },
    {
      "pivot": "year",
      "value": "total",
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "datum['2021']",
      "as": "y2021"
    },
    {
      "calculate": "datum['2024']",
      "as": "y2024"
    },
    {
      "calculate": "datum.y2024 - datum.y2021",
      "as": "change"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": [
        "Terengganu",
        "Kelantan",
        "Pulau Pinang",
        "Wilayah Persekutuan",
        "Johor",
        "Pahang",
        "Melaka",
        "Selangor",
        "Kedah",
        "Perlis",
        "Negeri Sembilan",
        "Perak"
      ],
      "title": null,
      "axis": {
        "labelColor": "#edf1e8",
        "labelFontSize": 13,
        "ticks": false,
        "labelPadding": 10,
        "labelExpr": "datum.label == 'Wilayah Persekutuan' ? 'Federal Territories' : datum.label"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 22,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -600,
              2900
            ]
          },
          "axis": {
            "title": "Change in animals handed over, 2021 to 2024",
            "values": [
              -500,
              0,
              500,
              1000,
              1500,
              2000,
              2500
            ],
            "format": "+,d",
            "grid": true
          }
        },
        "color": {
          "condition": {
            "test": "datum.change < 0",
            "value": "#e7ad55"
          },
          "value": "#68adbd"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "Reporting unit"
          },
          {
            "field": "y2021",
            "type": "quantitative",
            "title": "2021",
            "format": ","
          },
          {
            "field": "y2024",
            "type": "quantitative",
            "title": "2024",
            "format": ","
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change",
            "format": "+,"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#afc3b8",
        "strokeWidth": 1.75
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "y": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.change >= 0"
        },
        {
          "calculate": "(datum.change >= 0 ? '+' : '−') + format(abs(datum.change), ',') + '   (' + format(datum.y2021, ',') + ' → ' + format(datum.y2024, ',') + ')'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#edf1e8"
      },
      "encoding": {
        "x": {
          "field": "change",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.change < 0"
        },
        {
          "calculate": "(datum.change >= 0 ? '+' : '−') + format(abs(datum.change), ',') + '   (' + format(datum.y2021, ',') + ' → ' + format(datum.y2024, ',') + ')'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#edbf79"
      },
      "encoding": {
        "x": {
          "field": "change",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 30,
            "t": "More animals than in 2021 →"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dy": -6,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#c6d1ca"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": -30,
            "t": "← Fewer"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -6,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#c6d1ca"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 600,
      "labelColor": "#c6d1ca",
      "titleColor": "#edf1e8",
      "domain": false,
      "gridColor": "#3a4842",
      "tickColor": "#3a4842",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 600,
      "labelColor": "#edf1e8",
      "titleColor": "#edf1e8",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#edf1e8"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#edf1e8",
      "subtitleColor": "#c6d1ca"
    }
  }
}
