{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "domain": false,
      "gridColor": "#e2e7de",
      "tickColor": "#bac8bc",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "padding": 16
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#243c32"
    },
    "range": {
      "category": [
        "#225b43",
        "#b26130",
        "#628ba3",
        "#7d6b97",
        "#8f9547",
        "#9c6970"
      ]
    }
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8ede3",
        "stroke": "#fffdf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/release-state-flows.json"
      },
      "transform": [
        {
          "filter": "datum.state !== 'Perak'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#225b43",
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "origin_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "origin_latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude"
        },
        "latitude2": {
          "field": "latitude"
        },
        "strokeWidth": {
          "field": "animals",
          "type": "quantitative",
          "title": "Animals released",
          "scale": {
            "range": [
              1,
              9
            ],
            "zero": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "origin",
            "type": "nominal",
            "title": "From"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "Destination state"
          },
          {
            "field": "animals",
            "type": "quantitative",
            "title": "Animals"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/release-state-flows.json"
      },
      "mark": {
        "type": "circle",
        "size": 100,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.state === 'Perak'",
            "value": "#b26130"
          },
          "value": "#225b43"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "animals",
            "type": "quantitative",
            "title": "Animals released here"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/release-state-flows.json"
      },
      "transform": [
        {
          "calculate": "datum.state + ' \u00b7 ' + datum.animals",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#243c32"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}