{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "domain": false,
      "gridColor": "#e2e7de",
      "tickColor": "#bac8bc",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "padding": 16
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#243c32"
    },
    "range": {
      "category": [
        "#225b43",
        "#b26130",
        "#628ba3",
        "#7d6b97",
        "#8f9547",
        "#9c6970"
      ]
    }
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8ede3",
        "stroke": "#fffdf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state-anchors.json"
      },
      "params": [
        {
          "name": "stateHover",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#225b43",
        "stroke": "white",
        "strokeWidth": 1.4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "total",
          "type": "quantitative",
          "title": "Animals handed over",
          "scale": {
            "range": [
              0,
              1800
            ],
            "zero": true
          },
          "legend": {
            "values": [
              500,
              1500,
              2800
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "stateHover",
            "value": 0.85
          },
          "value": 0.4
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "Reporting state"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Animals handed over",
            "format": ","
          },
          {
            "field": "mammals",
            "type": "quantitative",
            "title": "Mammals",
            "format": ","
          },
          {
            "field": "reptiles",
            "type": "quantitative",
            "title": "Reptiles",
            "format": ","
          },
          {
            "field": "birds",
            "type": "quantitative",
            "title": "Birds",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state-anchors.json"
      },
      "transform": [
        {
          "filter": "datum.state === 'Kelantan' || datum.state === 'Johor' || datum.state === 'Selangor'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#243c32"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ]
}