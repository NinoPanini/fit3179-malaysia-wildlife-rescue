{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "domain": false,
      "gridColor": "#e2e7de",
      "tickColor": "#bac8bc",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "padding": 16
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#243c32"
    },
    "range": {
      "category": [
        "#225b43",
        "#b26130",
        "#628ba3",
        "#7d6b97",
        "#8f9547",
        "#9c6970"
      ]
    }
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8ede3",
        "stroke": "#fffdf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "data/handovers-2024.json"
            },
            "key": "state",
            "fields": [
              "total",
              "mammals",
              "mammal_share"
            ]
          }
        },
        {
          "filter": "isValid(datum.mammal_share)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffdf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "mammal_share",
          "type": "quantitative",
          "title": "Mammal share",
          "scale": {
            "domain": [
              0,
              0.6
            ],
            "range": [
              "#edf2d9",
              "#185b42"
            ]
          },
          "legend": {
            "format": ".0%"
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "mammal_share",
            "type": "quantitative",
            "title": "Mammal share",
            "format": ".1%"
          },
          {
            "field": "mammals",
            "type": "quantitative",
            "title": "Mammals",
            "format": ","
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "All handovers",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state-anchors.json"
      },
      "transform": [
        {
          "filter": "datum.state === 'Selangor'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "dy": 5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#243c32"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "value": "Selangor \u00b7 59%"
        }
      }
    }
  ]
}