{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Treemap: 2025 BSBCC volunteer placements by listed country of origin; block area shows placements.",
  "width": "container",
  "height": 300,
  "padding": {
    "top": 26,
    "left": 2,
    "right": 2,
    "bottom": 2
  },
  "data": {
    "url": "data/volunteer-origins-treemap.json"
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.level == 'country'"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#fbf9f2",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              300
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Malaysia",
              "Other countries"
            ],
            "range": [
              "#2f4858",
              "#8a8270"
            ]
          }
        },
        "tooltip": [
          {
            "field": "origin",
            "title": "Listed origin"
          },
          {
            "field": "placements",
            "type": "quantitative",
            "title": "Placements"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.level == 'group'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#fbf9f2",
        "strokeWidth": 6
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              300
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.level == 'country'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 8,
        "dy": 7,
        "fontSize": 13,
        "fontWeight": 700,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              300
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.group == 'Malaysia'",
            "value": "white"
          },
          "value": "#141c19"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.level == 'group'"
        },
        {
          "calculate": "datum.group == 'Malaysia' ? 'From Malaysia · ' + datum.placements : 'From eight other countries · ' + datum.placements",
          "as": "head"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 2,
        "dy": -8,
        "fontSize": 13.5,
        "fontWeight": 700,
        "color": "#1f2d2a"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "head"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
