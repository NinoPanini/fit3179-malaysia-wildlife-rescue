{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart: 2025 BSBCC volunteer placements by listed country of origin.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/bsbcc-origins-2025.json"
  },
  "encoding": {
    "y": {
      "field": "origin",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelFontSize": 13.5,
        "labelColor": "#1f2d2a"
      }
    },
    "x": {
      "field": "placements",
      "type": "quantitative",
      "title": "Volunteer placements, 2025",
      "scale": {
        "domain": [
          0,
          30
        ]
      },
      "axis": {
        "tickCount": 4
      }
    },
    "color": {
      "condition": {
        "test": "datum.origin == 'Malaysia'",
        "value": "#2f4858"
      },
      "value": "#E1B04F"
    },
    "tooltip": [
      {
        "field": "origin",
        "title": "Listed origin"
      },
      {
        "field": "placements",
        "type": "quantitative",
        "title": "Placements"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 1
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "placements"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
