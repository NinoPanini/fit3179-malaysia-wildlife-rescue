{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly volunteer placement starts, split by origin, linked to a column chart of four stay lengths. All counts are labelled. Select a month by click or menu; All months resets.",
  "usermeta": {
    "fitWidth": 1100,
    "mobileStack": true
  },
  "data": {
    "url": "data/bsbcc-placements-2025.json"
  },
  "transform": [
    {
      "calculate": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][toNumber(substring(datum.start, 5, 7)) - 1]",
      "as": "month"
    }
  ],
  "params": [
    {
      "name": "selectedMonth",
      "value": "All months",
      "bind": {
        "input": "select",
        "options": [
          "All months",
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "name": "Month: ",
        "element": "#placement-control"
      }
    }
  ],
  "hconcat": [
    {
      "width": 560,
      "height": 300,
      "title": {
        "text": "11 · When did placements start?",
        "subtitle": "2025 · Monthly starts",
        "fontSize": 17,
        "subtitleFontSize": 13,
        "offset": 18
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "axis": {
            "title": "Start month · 2025",
            "labelAngle": 0,
            "labelFontSize": 13
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "title": "Placements starting",
          "scale": {
            "domain": [
              0,
              14
            ]
          },
          "axis": {
            "values": [
              0,
              3,
              6,
              9,
              12
            ]
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "placements"
                }
              ],
              "groupby": [
                "month",
                "origin_group"
              ]
            },
            {
              "calculate": "datum.origin_group == 'Malaysia' ? 0 : 1",
              "as": "group_order"
            },
            {
              "stack": "placements",
              "groupby": [
                "month"
              ],
              "sort": [
                {
                  "field": "group_order"
                }
              ],
              "as": [
                "bottom",
                "top"
              ]
            },
            {
              "calculate": "(datum.bottom + datum.top) / 2",
              "as": "middle"
            }
          ],
          "mark": {
            "type": "bar",
            "stroke": "#fbf9f2",
            "strokeWidth": 1,
            "cursor": "pointer"
          },
          "encoding": {
            "y2": {
              "field": "bottom"
            },
            "color": {
              "field": "origin_group",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#2f4858",
                  "#8a8270"
                ]
              },
              "legend": {
                "orient": "top",
                "symbolType": "square",
                "labelFontSize": 14
              }
            },
            "opacity": {
              "condition": {
                "test": "selectedMonth == 'All months' || datum.month == selectedMonth",
                "value": 1
              },
              "value": 0.3
            },
            "tooltip": [
              {
                "field": "month",
                "title": "Start month"
              },
              {
                "field": "origin_group",
                "title": "Origin"
              },
              {
                "field": "placements",
                "title": "Placements in this group",
                "type": "quantitative"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "placements"
                }
              ],
              "groupby": [
                "month",
                "origin_group"
              ]
            },
            {
              "calculate": "datum.origin_group == 'Malaysia' ? 0 : 1",
              "as": "group_order"
            },
            {
              "stack": "placements",
              "groupby": [
                "month"
              ],
              "sort": [
                {
                  "field": "group_order"
                }
              ],
              "as": [
                "bottom",
                "top"
              ]
            },
            {
              "calculate": "(datum.bottom + datum.top) / 2",
              "as": "middle"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "cursor": "pointer"
          },
          "encoding": {
            "y": {
              "field": "middle",
              "type": "quantitative"
            },
            "text": {
              "field": "placements"
            },
            "color": {
              "condition": {
                "test": "datum.origin_group == 'Malaysia'",
                "value": "white"
              },
              "value": "#141c19"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "total"
                }
              ],
              "groupby": [
                "month"
              ]
            }
          ],
          "mark": {
            "type": "text",
            "dy": -9,
            "fontSize": 15,
            "fontWeight": 700,
            "cursor": "pointer"
          },
          "encoding": {
            "y": {
              "field": "total",
              "type": "quantitative"
            },
            "text": {
              "field": "total"
            }
          }
        }
      ]
    },
    {
      "width": 360,
      "height": 300,
      "title": {
        "text": "12 · How long did they stay?",
        "subtitle": {
          "expr": "selectedMonth == 'All months' ? 'All 57 placements · 2025' : 'Placements starting in ' + selectedMonth + ' · 2025'"
        },
        "fontSize": 17,
        "subtitleFontSize": 13,
        "offset": 18
      },
      "transform": [
        {
          "filter": "selectedMonth == 'All months' || datum.month == selectedMonth"
        },
        {
          "calculate": "datum.days <= 13 ? 'Under 2 weeks' : datum.days == 14 ? 'Exactly 2 weeks' : datum.days <= 28 ? '2 to 4 weeks' : 'Over 4 weeks'",
          "as": "stay"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "placements"
            }
          ],
          "groupby": [
            "stay"
          ]
        },
        {
          "impute": "placements",
          "key": "stay",
          "keyvals": [
            "Under 2 weeks",
            "Exactly 2 weeks",
            "2 to 4 weeks",
            "Over 4 weeks"
          ],
          "value": 0
        }
      ],
      "encoding": {
        "x": {
          "field": "stay",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Under 2 weeks",
              "Exactly 2 weeks",
              "2 to 4 weeks",
              "Over 4 weeks"
            ],
            "paddingInner": 0.25,
            "paddingOuter": 0.12
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelColor": "#1f2d2a",
            "labelExpr": "[datum.value, {\"Under 2 weeks\": \"11\\u201313 days\", \"Exactly 2 weeks\": \"14 days\", \"2 to 4 weeks\": \"15\\u201328 days\", \"Over 4 weeks\": \"29\\u201339 days\"}[datum.value]]"
          }
        },
        "y": {
          "field": "placements",
          "type": "quantitative",
          "title": "Placements",
          "scale": {
            "domain": [
              0,
              25
            ]
          },
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20
            ]
          }
        },
        "tooltip": [
          {
            "field": "stay",
            "title": "Length of stay"
          },
          {
            "field": "placements",
            "title": "Placements",
            "type": "quantitative"
          }
        ]
      },
      "layer": [
        {
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "rect",
            "color": "#e6e0cf"
          },
          "encoding": {
            "x": {
              "datum": "Under 2 weeks",
              "bandPosition": -0.12
            },
            "x2": {
              "datum": "Exactly 2 weeks",
              "bandPosition": 1.12
            },
            "y": {
              "value": 0
            },
            "y2": {
              "value": "height"
            },
            "tooltip": null
          }
        },
        {
          "transform": [
            {
              "joinaggregate": [
                {
                  "op": "sum",
                  "field": "placements",
                  "as": "all"
                }
              ]
            },
            {
              "filter": "datum.stay == 'Under 2 weeks' || datum.stay == 'Exactly 2 weeks'"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "placements",
                  "as": "short"
                },
                {
                  "op": "max",
                  "field": "all",
                  "as": "all"
                }
              ]
            },
            {
              "calculate": "[datum.short + ' of ' + datum.all + ' stayed', 'two weeks or less']",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 6,
            "fontSize": 13,
            "fontWeight": 700,
            "lineHeight": 16,
            "color": "#1f2d2a"
          },
          "encoding": {
            "x": {
              "datum": "Under 2 weeks"
            },
            "y": {
              "value": 6
            },
            "text": {
              "field": "t"
            },
            "tooltip": null
          }
        },
        {
          "mark": {
            "type": "bar",
            "color": "#2f4858"
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -9,
            "fontSize": 15,
            "fontWeight": 700
          },
          "encoding": {
            "text": {
              "field": "placements"
            }
          }
        }
      ]
    }
  ],
  "spacing": 44,
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
