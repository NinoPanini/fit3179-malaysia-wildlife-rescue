{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly volunteer placement starts, split by origin, linked to an isotype of stay lengths (one person figure per placement). All counts are labelled. Select a month by click or menu; All months resets.",
  "usermeta": {
    "fitWidth": 1100,
    "mobileStack": true
  },
  "data": {
    "url": "data/bsbcc-placements-2025.json"
  },
  "transform": [
    {
      "calculate": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][toNumber(substring(datum.start, 5, 7)) - 1]",
      "as": "month"
    }
  ],
  "params": [
    {
      "name": "selectedMonth",
      "value": "All months",
      "bind": {
        "input": "select",
        "options": [
          "All months",
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "name": "Month: ",
        "element": "#placement-control"
      }
    }
  ],
  "hconcat": [
    {
      "width": 440,
      "height": 300,
      "title": {
        "text": "11 · Placements by start month",
        "subtitle": "2025 · new arrivals each month",
        "fontSize": 17,
        "subtitleFontSize": 13,
        "offset": 18
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "axis": {
            "title": "Start month · 2025",
            "labelAngle": 0,
            "labelFontSize": 13
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "title": "Placements starting",
          "scale": {
            "domain": [
              0,
              14
            ]
          },
          "axis": {
            "values": [
              0,
              3,
              6,
              9,
              12
            ]
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "placements"
                }
              ],
              "groupby": [
                "month",
                "origin_group"
              ]
            },
            {
              "calculate": "datum.origin_group == 'Malaysia' ? 0 : 1",
              "as": "group_order"
            },
            {
              "stack": "placements",
              "groupby": [
                "month"
              ],
              "sort": [
                {
                  "field": "group_order"
                }
              ],
              "as": [
                "bottom",
                "top"
              ]
            },
            {
              "calculate": "(datum.bottom + datum.top) / 2",
              "as": "middle"
            }
          ],
          "mark": {
            "type": "bar",
            "stroke": "#fbf9f2",
            "strokeWidth": 1,
            "cursor": "pointer"
          },
          "encoding": {
            "y2": {
              "field": "bottom"
            },
            "color": {
              "field": "origin_group",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#2f4858",
                  "#8a8270"
                ]
              },
              "legend": {
                "orient": "top",
                "symbolType": "square",
                "labelFontSize": 14
              }
            },
            "tooltip": [
              {
                "field": "month",
                "title": "Start month"
              },
              {
                "field": "origin_group",
                "title": "Origin"
              },
              {
                "field": "placements",
                "title": "Placements in this group",
                "type": "quantitative"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "placements"
                }
              ],
              "groupby": [
                "month",
                "origin_group"
              ]
            },
            {
              "calculate": "datum.origin_group == 'Malaysia' ? 0 : 1",
              "as": "group_order"
            },
            {
              "stack": "placements",
              "groupby": [
                "month"
              ],
              "sort": [
                {
                  "field": "group_order"
                }
              ],
              "as": [
                "bottom",
                "top"
              ]
            },
            {
              "calculate": "(datum.bottom + datum.top) / 2",
              "as": "middle"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "cursor": "pointer"
          },
          "encoding": {
            "y": {
              "field": "middle",
              "type": "quantitative"
            },
            "text": {
              "field": "placements"
            },
            "color": {
              "condition": {
                "test": "datum.origin_group == 'Malaysia'",
                "value": "white"
              },
              "value": "#141c19"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "total"
                }
              ],
              "groupby": [
                "month"
              ]
            }
          ],
          "mark": {
            "type": "text",
            "dy": -9,
            "fontSize": 15,
            "fontWeight": 700,
            "cursor": "pointer"
          },
          "encoding": {
            "y": {
              "field": "total",
              "type": "quantitative"
            },
            "text": {
              "field": "total"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "total"
                }
              ],
              "groupby": [
                "month"
              ]
            },
            {
              "filter": "datum.month == selectedMonth"
            }
          ],
          "mark": {
            "type": "bar",
            "fillOpacity": 0,
            "stroke": "#1f2d2a",
            "strokeWidth": 3
          },
          "encoding": {
            "y": {
              "field": "total",
              "type": "quantitative"
            },
            "y2": {
              "datum": 0
            }
          }
        }
      ]
    },
    {
      "width": 400,
      "height": 280,
      "title": {
        "text": "12 · Placements by length of stay",
        "subtitle": {
          "expr": "selectedMonth == 'All months' ? 'Each figure is one placement · 38 of 57 stayed two weeks or less' : 'Solid: placements starting in ' + selectedMonth + ' · outline: other months'"
        },
        "fontSize": 17,
        "subtitleFontSize": 13,
        "offset": 18
      },
      "layer": [
        {
          "transform": [
            {
              "calculate": "datum.days <= 13 ? 'Under 2 weeks' : datum.days == 14 ? 'Exactly 2 weeks' : datum.days <= 28 ? '2 to 4 weeks' : 'Over 4 weeks'",
              "as": "stay"
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "k"
                }
              ],
              "groupby": [
                "stay"
              ],
              "sort": [
                {
                  "field": "origin_group"
                },
                {
                  "field": "start"
                }
              ]
            },
            {
              "calculate": "datum.k - 1 + (datum.origin_group == 'Malaysia' ? 0 : 1)",
              "as": "slot"
            },
            {
              "filter": "(selectedMonth == 'All months' || datum.month == selectedMonth)"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "M0,-1A.3,.3 0 1,1 0,-.4A.3,.3 0 1,1 0,-1ZM-.55,1L-.55,.05Q-.55,-.3 -.25,-.3L.25,-.3Q.55,-.3 .55,.05L.55,1Z",
            "filled": true,
            "opacity": 1,
            "size": 330,
            "strokeWidth": 0,
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "slot",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -0.6,
                  21.8
                ],
                "nice": false
              },
              "axis": null
            },
            "y": {
              "field": "stay",
              "type": "ordinal",
              "scale": {
                "domain": [
                  "Under 2 weeks",
                  "Exactly 2 weeks",
                  "2 to 4 weeks",
                  "Over 4 weeks"
                ]
              },
              "title": null,
              "axis": {
                "labelFontSize": 13.5,
                "labelColor": "#1f2d2a",
                "labelPadding": 10,
                "ticks": false,
                "domain": false,
                "labelExpr": "[datum.value, {\"Under 2 weeks\": \"11\\u201313 days\", \"Exactly 2 weeks\": \"14 days\", \"2 to 4 weeks\": \"15\\u201328 days\", \"Over 4 weeks\": \"29\\u201339 days\"}[datum.value]]"
              }
            },
            "color": {
              "field": "origin_group",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#2f4858",
                  "#8a8270"
                ]
              },
              "legend": {
                "orient": "top",
                "symbolType": "square",
                "labelFontSize": 14
              }
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "Listed origin"
              },
              {
                "field": "start",
                "title": "Start date"
              },
              {
                "field": "days",
                "type": "quantitative",
                "title": "Days on site"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.days <= 13 ? 'Under 2 weeks' : datum.days == 14 ? 'Exactly 2 weeks' : datum.days <= 28 ? '2 to 4 weeks' : 'Over 4 weeks'",
              "as": "stay"
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "k"
                }
              ],
              "groupby": [
                "stay"
              ],
              "sort": [
                {
                  "field": "origin_group"
                },
                {
                  "field": "start"
                }
              ]
            },
            {
              "calculate": "datum.k - 1 + (datum.origin_group == 'Malaysia' ? 0 : 1)",
              "as": "slot"
            },
            {
              "filter": "!(selectedMonth == 'All months' || datum.month == selectedMonth)"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "M0,-1A.3,.3 0 1,1 0,-.4A.3,.3 0 1,1 0,-1ZM-.55,1L-.55,.05Q-.55,-.3 -.25,-.3L.25,-.3Q.55,-.3 .55,.05L.55,1Z",
            "filled": false,
            "opacity": 1,
            "size": 330,
            "strokeWidth": 1.2,
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "slot",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -0.6,
                  21.8
                ],
                "nice": false
              },
              "axis": null
            },
            "y": {
              "field": "stay",
              "type": "ordinal",
              "scale": {
                "domain": [
                  "Under 2 weeks",
                  "Exactly 2 weeks",
                  "2 to 4 weeks",
                  "Over 4 weeks"
                ]
              },
              "title": null,
              "axis": {
                "labelFontSize": 13.5,
                "labelColor": "#1f2d2a",
                "labelPadding": 10,
                "ticks": false,
                "domain": false,
                "labelExpr": "[datum.value, {\"Under 2 weeks\": \"11\\u201313 days\", \"Exactly 2 weeks\": \"14 days\", \"2 to 4 weeks\": \"15\\u201328 days\", \"Over 4 weeks\": \"29\\u201339 days\"}[datum.value]]"
              }
            },
            "color": {
              "field": "origin_group",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#2f4858",
                  "#8a8270"
                ]
              },
              "legend": {
                "orient": "top",
                "symbolType": "square",
                "labelFontSize": 14
              }
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "Listed origin"
              },
              {
                "field": "start",
                "title": "Start date"
              },
              {
                "field": "days",
                "type": "quantitative",
                "title": "Days on site"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.days <= 13 ? 'Under 2 weeks' : datum.days == 14 ? 'Exactly 2 weeks' : datum.days <= 28 ? '2 to 4 weeks' : 'Over 4 weeks'",
              "as": "stay"
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                }
              ],
              "groupby": [
                "stay"
              ]
            },
            {
              "calculate": "datum.n + 0.6",
              "as": "end"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 16,
            "fontWeight": 700,
            "color": "#1f2d2a"
          },
          "encoding": {
            "x": {
              "field": "end",
              "type": "quantitative"
            },
            "y": {
              "field": "stay",
              "type": "ordinal",
              "scale": {
                "domain": [
                  "Under 2 weeks",
                  "Exactly 2 weeks",
                  "2 to 4 weeks",
                  "Over 4 weeks"
                ]
              },
              "title": null,
              "axis": {
                "labelFontSize": 13.5,
                "labelColor": "#1f2d2a",
                "labelPadding": 10,
                "ticks": false,
                "domain": false,
                "labelExpr": "[datum.value, {\"Under 2 weeks\": \"11\\u201313 days\", \"Exactly 2 weeks\": \"14 days\", \"2 to 4 weeks\": \"15\\u201328 days\", \"Over 4 weeks\": \"29\\u201339 days\"}[datum.value]]"
              }
            },
            "text": {
              "field": "n"
            }
          }
        }
      ]
    }
  ],
  "spacing": 76,
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
