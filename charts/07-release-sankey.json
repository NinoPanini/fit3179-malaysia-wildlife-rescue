{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "domain": false,
      "gridColor": "#e2e7de",
      "tickColor": "#bac8bc",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "padding": 16
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#243c32"
    },
    "range": {
      "category": [
        "#225b43",
        "#b26130",
        "#628ba3",
        "#7d6b97",
        "#8f9547",
        "#9c6970"
      ]
    }
  },
  "params": [
    {
      "name": "destinationChoice",
      "value": "All destinations",
      "bind": {
        "input": "select",
        "options": [
          "All destinations",
          "Temenggor Forest Reserve",
          "Taman Negara Terengganu",
          "Taman Negara Pahang",
          "Ulu Muda Forest Reserve",
          "Penang National Park",
          "Sungkai Wildlife Reserve"
        ],
        "name": "Highlight destination: "
      }
    }
  ],
  "padding": {
    "left": 160,
    "right": 185,
    "top": 10,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": null
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "scale": {
        "reverse": true,
        "domain": [
          0,
          43
        ]
      },
      "axis": null
    },
    "color": {
      "field": "destination",
      "type": "nominal",
      "legend": null
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/release-ribbons.json"
      },
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "test": "destinationChoice === 'All destinations' || datum.destination === destinationChoice",
            "value": 0.55
          },
          "value": 0.07
        },
        "y2": {
          "field": "y2"
        },
        "detail": {
          "field": "species"
        },
        "tooltip": [
          {
            "field": "species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "animals",
            "type": "quantitative",
            "title": "Animals"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/release-nodes.json"
      },
      "mark": "rect",
      "encoding": {
        "x2": {
          "field": "x2"
        },
        "y2": {
          "field": "y2"
        },
        "tooltip": [
          {
            "field": "label",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "animals",
            "type": "quantitative",
            "title": "Animals"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/release-nodes.json"
      },
      "transform": [
        {
          "filter": "datum.side === 'species'"
        },
        {
          "calculate": "datum.label + ' \u00b7 ' + datum.animals",
          "as": "label_count"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 12,
        "color": "#243c32"
      },
      "encoding": {
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "label_count"
        },
        "color": {
          "value": "#243c32"
        }
      }
    },
    {
      "data": {
        "url": "data/release-nodes.json"
      },
      "transform": [
        {
          "filter": "datum.side === 'destination'"
        },
        {
          "calculate": "datum.label + ' \u00b7 ' + datum.animals",
          "as": "label_count"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "color": "#243c32"
      },
      "encoding": {
        "x": {
          "field": "x2",
          "type": "quantitative"
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "label_count"
        },
        "color": {
          "value": "#243c32"
        }
      }
    }
  ]
}