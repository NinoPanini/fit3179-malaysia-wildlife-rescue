{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small bar chart of total animals handed over to PERHILITAN each year, 2021-2024.",
  "width": 220,
  "height": 70,
  "data": {
    "url": "data/handovers-national.json"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelColor": "#1f2d2a",
        "labelFontSize": 13
      }
    },
    "y": {
      "field": "total",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          17000
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "total",
        "type": "quantitative",
        "title": "Animals handed over",
        "format": ","
      },
      {
        "field": "source",
        "title": "Source"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": 24,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!datum.state_table",
            "value": "#b9b39f"
          },
          "value": "#3e5260"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -5,
        "baseline": "bottom",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "total",
          "format": ","
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
