{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map: circle area shows wildlife handed over in each reporting state, 2024.",
  "width": "container",
  "height": 470,
  "padding": {
    "left": 72,
    "top": 5,
    "right": 5,
    "bottom": 5
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/peninsular-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#3f514b",
        "stroke": "#83968a",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Perlis",
            "name": "Perlis",
            "lon": 99.85,
            "lat": 6.62,
            "align": "right",
            "leader": true
          },
          {
            "state": "Kedah",
            "name": "Kedah",
            "lon": 99.85,
            "lat": 6.08,
            "align": "right",
            "leader": true
          },
          {
            "state": "Pulau Pinang",
            "name": "Pulau Pinang",
            "lon": 99.85,
            "lat": 5.42,
            "align": "right",
            "leader": true
          },
          {
            "state": "Perak",
            "name": "Perak",
            "lon": 100.2,
            "lat": 4.5,
            "align": "right",
            "leader": true
          },
          {
            "state": "Kelantan",
            "name": "Kelantan",
            "lon": 102.6,
            "lat": 6.4,
            "align": "left",
            "leader": true
          },
          {
            "state": "Terengganu",
            "name": "Terengganu",
            "lon": 103.55,
            "lat": 5.2,
            "align": "left",
            "leader": true
          },
          {
            "state": "Pahang",
            "name": "Pahang",
            "lon": 103.75,
            "lat": 3.75,
            "align": "left",
            "leader": true
          },
          {
            "state": "Selangor",
            "name": "Selangor",
            "lon": 100.85,
            "lat": 3.62,
            "align": "right",
            "leader": true
          },
          {
            "state": "Wilayah Persekutuan",
            "name": "Federal Territories",
            "lon": 100.95,
            "lat": 3.08,
            "align": "right",
            "leader": true
          },
          {
            "state": "Negeri Sembilan",
            "name": "Negeri Sembilan",
            "lon": 101.15,
            "lat": 2.6,
            "align": "right",
            "leader": true
          },
          {
            "state": "Melaka",
            "name": "Melaka",
            "lon": 101.7,
            "lat": 2.08,
            "align": "right",
            "leader": true
          },
          {
            "state": "Johor",
            "name": "Johor",
            "lon": 104.15,
            "lat": 2.1,
            "align": "left",
            "leader": true
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state-anchors.json"
            },
            "key": "state",
            "fields": [
              "longitude",
              "latitude"
            ]
          }
        },
        {
          "calculate": "isValid(datum.longitude) ? datum.state == 'Selangor' ? 101.3 : datum.longitude : 101.69",
          "as": "ax"
        },
        {
          "calculate": "isValid(datum.latitude) ? datum.state == 'Selangor' ? 3.45 : datum.latitude : 3.12",
          "as": "ay"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#a3b5ab",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "ax"
        },
        "latitude2": {
          "field": "ay"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Wilayah Persekutuan",
            "longitude": 101.69,
            "latitude": 3.12
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/handovers-2024.json"
            },
            "key": "state",
            "fields": [
              "total",
              "reptiles",
              "mammals",
              "birds"
            ]
          }
        },
        {
          "calculate": "'Federal Territories (combined)'",
          "as": "state"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#80c3de",
        "stroke": "#17201e",
        "strokeWidth": 1.5,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "total",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "Reporting unit"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Animals handed over",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state-anchors.json"
      },
      "transform": [
        {
          "calculate": "datum.state == 'Selangor' ? 101.3 : datum.longitude",
          "as": "x_lon"
        },
        {
          "calculate": "datum.state == 'Selangor' ? 3.45 : datum.latitude",
          "as": "x_lat"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#80c3de",
        "stroke": "#17201e",
        "strokeWidth": 1.5,
        "opacity": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "x_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "x_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "total",
          "type": "quantitative",
          "title": "Animals handed over",
          "scale": {
            "range": [
              0,
              1900
            ],
            "zero": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "Reporting state"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Animals handed over",
            "format": ","
          },
          {
            "field": "reptiles",
            "type": "quantitative",
            "title": "Reptiles",
            "format": ","
          },
          {
            "field": "mammals",
            "type": "quantitative",
            "title": "Mammals",
            "format": ","
          },
          {
            "field": "birds",
            "type": "quantitative",
            "title": "Birds",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Kelantan",
            "name": "Kelantan",
            "lon": 102.6,
            "lat": 6.4,
            "align": "left",
            "leader": true
          },
          {
            "state": "Terengganu",
            "name": "Terengganu",
            "lon": 103.55,
            "lat": 5.2,
            "align": "left",
            "leader": true
          },
          {
            "state": "Pahang",
            "name": "Pahang",
            "lon": 103.75,
            "lat": 3.75,
            "align": "left",
            "leader": true
          },
          {
            "state": "Johor",
            "name": "Johor",
            "lon": 104.15,
            "lat": 2.1,
            "align": "left",
            "leader": true
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/handovers-2024.json"
            },
            "key": "state",
            "fields": [
              "total"
            ]
          }
        },
        {
          "calculate": "[datum.name, format(datum.total, ',')]",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15,
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Perlis",
            "name": "Perlis",
            "lon": 99.85,
            "lat": 6.62,
            "align": "right",
            "leader": true
          },
          {
            "state": "Kedah",
            "name": "Kedah",
            "lon": 99.85,
            "lat": 6.08,
            "align": "right",
            "leader": true
          },
          {
            "state": "Pulau Pinang",
            "name": "Pulau Pinang",
            "lon": 99.85,
            "lat": 5.42,
            "align": "right",
            "leader": true
          },
          {
            "state": "Perak",
            "name": "Perak",
            "lon": 100.2,
            "lat": 4.5,
            "align": "right",
            "leader": true
          },
          {
            "state": "Selangor",
            "name": "Selangor",
            "lon": 100.85,
            "lat": 3.62,
            "align": "right",
            "leader": true
          },
          {
            "state": "Wilayah Persekutuan",
            "name": "Federal Territories",
            "lon": 100.95,
            "lat": 3.08,
            "align": "right",
            "leader": true
          },
          {
            "state": "Negeri Sembilan",
            "name": "Negeri Sembilan",
            "lon": 101.15,
            "lat": 2.6,
            "align": "right",
            "leader": true
          },
          {
            "state": "Melaka",
            "name": "Melaka",
            "lon": 101.7,
            "lat": 2.08,
            "align": "right",
            "leader": true
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/handovers-2024.json"
            },
            "key": "state",
            "fields": [
              "total"
            ]
          }
        },
        {
          "calculate": "[datum.name, format(datum.total, ',')]",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15,
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#c6d1ca",
      "titleColor": "#edf1e8",
      "domain": false,
      "gridColor": "#3a4842",
      "tickColor": "#3a4842",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#edf1e8",
      "titleColor": "#edf1e8",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#edf1e8"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#edf1e8",
      "subtitleColor": "#c6d1ca"
    }
  }
}
