{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 180,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "domain": false,
      "gridColor": "#e2e7de",
      "tickColor": "#bac8bc",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#243c32",
      "titleColor": "#243c32",
      "padding": 16
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#243c32"
    },
    "range": {
      "category": [
        "#225b43",
        "#b26130",
        "#628ba3",
        "#7d6b97",
        "#8f9547",
        "#9c6970"
      ]
    }
  },
  "data": {
    "url": "data/nwrc-intake-2024.json"
  },
  "params": [
    {
      "name": "animalGroup",
      "value": "All groups",
      "bind": {
        "input": "select",
        "options": [
          "All groups",
          "Reptiles",
          "Birds",
          "Mammals"
        ],
        "name": "Animal group: "
      }
    }
  ],
  "transform": [
    {
      "filter": "animalGroup === 'All groups' || datum.group === animalGroup"
    },
    {
      "calculate": "datum.animals === 0 ? '0' : datum.animals < 10 ? '1\u20139' : datum.animals < 100 ? '10\u201399' : datum.animals < 1000 ? '100\u2013999' : '1,000+'",
      "as": "band"
    }
  ],
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "sort": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Reptiles",
        "Birds",
        "Mammals"
      ],
      "axis": {
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "month",
        "type": "nominal",
        "title": "Month in 2024"
      },
      {
        "field": "group",
        "type": "nominal",
        "title": "Group"
      },
      {
        "field": "animals",
        "type": "quantitative",
        "title": "Animals received",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fffdf7",
        "strokeWidth": 3,
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Animals received",
          "scale": {
            "domain": [
              "0",
              "1\u20139",
              "10\u201399",
              "100\u2013999",
              "1,000+"
            ],
            "range": [
              "#f0f1eb",
              "#d5e2c5",
              "#a9c293",
              "#62956e",
              "#225b43"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "animals",
          "format": ","
        },
        "color": {
          "condition": {
            "test": "datum.animals >= 100",
            "value": "white"
          },
          "value": "#243c32"
        }
      }
    }
  ]
}