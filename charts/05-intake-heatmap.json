{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly intake with 2023 and 2024 paired for each animal group. Each cell shows the month as a share of that row's published year total; the year totals are printed at right.",
  "usermeta": {
    "fitWidth": 1050
  },
  "hconcat": [
    {
      "width": 28,
      "height": 330,
      "data": {
        "url": "data/nwrc-intake-totals.json"
      },
      "transform": [
        {
          "calculate": "datum.group + ' · ' + datum.year",
          "as": "row"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 220,
        "color": "#56625d",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "row",
          "type": "nominal",
          "sort": [
            "Reptiles · 2023",
            "Reptiles · 2024",
            "Mammals · 2023",
            "Mammals · 2024",
            "Birds · 2023",
            "Birds · 2024"
          ],
          "title": null,
          "axis": null
        },
        "shape": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Reptiles",
              "Mammals",
              "Birds"
            ],
            "range": [
              "M-.15,-.75 Q.4,-1 .45,-.55 L.25,-.25 .8,-.45 .95,-.2 .7,-.15 .2,.05 .75,.5 .6,.7 .1,.3 Q.1,.8 -.35,1 L-.1,.45 -.25,.1 -.75,.55 -.95,.35 -.65,.25 -.25,-.15 -.75,-.4 -.7,-.65 -.2,-.45 Z",
              "M-.5,.85 Q-1,.6 -.6,.15 Q0,-.65 .6,.15 Q1,.6 .5,.85 Q0,.55 -.5,.85 Z M-.9,-.45 A.23,.3 0 1,0 -.44,-.45 A.23,.3 0 1,0 -.9,-.45 M-.35,-.8 A.23,.3 0 1,0 .11,-.8 A.23,.3 0 1,0 -.35,-.8 M.25,-.7 A.23,.3 0 1,0 .71,-.7 A.23,.3 0 1,0 .25,-.7 M.65,-.2 A.21,.28 0 1,0 1.07,-.2 A.21,.28 0 1,0 .65,-.2",
              "M-1,.6 L-.6,.15 Q-.7,-.5 -.15,-.3 Q.1,-1 .65,-.65 L1,-.35 .7,-.3 Q.8,.35 .3,.6 Q-.15,.9 -.6,.6 Z"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "width": 720,
      "height": 330,
      "data": {
        "url": "data/nwrc-intake-2023-2024.json"
      },
      "transform": [
        {
          "calculate": "datum.group + ' · ' + datum.year",
          "as": "row"
        },
        {
          "calculate": "datum.animals / datum.year_total",
          "as": "share"
        },
        {
          "calculate": "!datum.reported ? 'Not available' : datum.animals == 0 ? '0 (none)' : datum.share < 0.05 ? 'above 0, under 5%' : datum.share < 0.15 ? '5–14%' : datum.share < 0.30 ? '15–29%' : '30% or more'",
          "as": "band"
        },
        {
          "calculate": "!datum.reported ? 'n/a' : datum.animals == 0 ? '0' : datum.share < 0.01 ? '<1%' : format(datum.share, '.0%')",
          "as": "label"
        }
      ],
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "orient": "top",
            "labelColor": "#1f2d2a"
          }
        },
        "y": {
          "field": "row",
          "type": "nominal",
          "sort": [
            "Reptiles · 2023",
            "Reptiles · 2024",
            "Mammals · 2023",
            "Mammals · 2024",
            "Birds · 2023",
            "Birds · 2024"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 14,
            "labelColor": "#1f2d2a",
            "labelPadding": 10,
            "ticks": false
          }
        },
        "tooltip": [
          {
            "field": "month",
            "title": "Month"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "animals",
            "type": "quantitative",
            "title": "Animals received",
            "format": ","
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of the year",
            "format": ".1%"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 3
          },
          "encoding": {
            "stroke": {
              "condition": {
                "test": "datum.animals == 0",
                "value": "#c9c3b0"
              },
              "value": "#fbf9f2"
            },
            "strokeWidth": {
              "condition": {
                "test": "datum.animals == 0",
                "value": 1
              },
              "value": 3
            },
            "color": {
              "field": "band",
              "type": "ordinal",
              "title": "Share of the row’s year total that arrived in the month",
              "scale": {
                "domain": [
                  "0 (none)",
                  "above 0, under 5%",
                  "5–14%",
                  "15–29%",
                  "30% or more",
                  "Not available"
                ],
                "range": [
                  "#fbf9f2",
                  "#ffffcc",
                  "#a1dab4",
                  "#41b6c4",
                  "#225ea8",
                  "#d6d0bf"
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "symbolType": "square",
                "titleLimit": 600,
                "symbolStrokeColor": "#bdb7a5",
                "symbolStrokeWidth": 1
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 14,
            "fontWeight": 500
          },
          "encoding": {
            "text": {
              "field": "label"
            },
            "color": {
              "condition": {
                "test": "datum.band == '30% or more'",
                "value": "white"
              },
              "value": "#1f2d2a"
            }
          }
        }
      ]
    },
    {
      "width": 95,
      "height": 330,
      "title": {
        "text": "Year total",
        "subtitle": "= 100% of the row",
        "anchor": "middle",
        "fontSize": 14,
        "subtitleFontSize": 12,
        "offset": 8
      },
      "data": {
        "url": "data/nwrc-intake-totals.json"
      },
      "transform": [
        {
          "calculate": "datum.group + ' · ' + datum.year",
          "as": "row"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 17,
        "fontWeight": 700
      },
      "encoding": {
        "y": {
          "field": "row",
          "type": "nominal",
          "sort": [
            "Reptiles · 2023",
            "Reptiles · 2024",
            "Mammals · 2023",
            "Mammals · 2024",
            "Birds · 2023",
            "Birds · 2024"
          ],
          "title": null,
          "axis": null
        },
        "text": {
          "field": "animals",
          "type": "quantitative",
          "format": ","
        },
        "tooltip": [
          {
            "field": "row",
            "title": "Group · year"
          },
          {
            "field": "animals",
            "type": "quantitative",
            "title": "Published annual total",
            "format": ","
          }
        ]
      }
    }
  ],
  "spacing": 16,
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
