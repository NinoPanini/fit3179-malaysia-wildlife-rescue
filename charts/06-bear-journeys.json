{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Timeline of nine sun bears at BSBCC, 2021-2025, with an enlarged view of the bear you click.",
  "usermeta": {
    "fitWidth": 960
  },
  "data": {
    "url": "data/bear-journeys.json"
  },
  "vconcat": [
    {
      "width": 860,
      "height": 418,
      "encoding": {
        "y": {
          "field": "bear",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Released to the forest · 5 bears",
              "Sunbearo",
              "Loki",
              "Wawa",
              "Sika",
              "Itam",
              "Still in care · 4 bears",
              "Rudy",
              "Kwong",
              "Tenom",
              "Pitang"
            ]
          },
          "axis": {
            "values": [
              "Sunbearo",
              "Loki",
              "Wawa",
              "Sika",
              "Itam",
              "Rudy",
              "Kwong",
              "Tenom",
              "Pitang"
            ],
            "labelFontSize": 15,
            "labelFontWeight": 600,
            "labelColor": "#1f2d2a",
            "labelPadding": 12,
            "grid": true,
            "gridColor": "#efece2"
          }
        }
      },
      "layer": [
        {
          "data": {
            "values": [
              {
                "head": "Released to the forest · 5 bears"
              },
              {
                "head": "Still in care · 4 bears"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 14,
            "fontWeight": 700,
            "color": "#56625d"
          },
          "encoding": {
            "y": {
              "field": "head",
              "type": "nominal",
              "title": null
            },
            "x": {
              "value": -90
            },
            "text": {
              "field": "head"
            }
          }
        },
        {
          "data": {
            "url": "data/bear-outcomes.json"
          },
          "mark": {
            "type": "rule",
            "strokeWidth": 2.5
          },
          "encoding": {
            "x": {
              "field": "first",
              "type": "temporal",
              "title": null,
              "axis": {
                "format": "%Y",
                "tickCount": {
                  "interval": "year"
                },
                "labelFontSize": 14,
                "labelColor": "#1f2d2a",
                "grid": true
              }
            },
            "x2": {
              "field": "last"
            },
            "color": {
              "condition": {
                "param": "bearPick",
                "value": "#1f2d2a"
              },
              "value": "#c9c3b0"
            }
          }
        },
        {
          "params": [
            {
              "name": "bearPick",
              "value": [
                {
                  "bear": "Itam"
                }
              ],
              "select": {
                "type": "point",
                "fields": [
                  "bear"
                ],
                "on": "click",
                "clear": false
              }
            },
            {
              "name": "kindPick",
              "select": {
                "type": "point",
                "fields": [
                  "kind"
                ]
              },
              "bind": "legend"
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 140,
            "stroke": "#fbf9f2",
            "strokeWidth": 1,
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal",
              "title": null,
              "axis": {
                "format": "%Y",
                "tickCount": {
                  "interval": "year"
                },
                "labelFontSize": 14,
                "labelColor": "#1f2d2a",
                "grid": true,
                "values": [
                  {
                    "year": 2021,
                    "month": 1,
                    "date": 1
                  },
                  {
                    "year": 2022,
                    "month": 1,
                    "date": 1
                  },
                  {
                    "year": 2023,
                    "month": 1,
                    "date": 1
                  },
                  {
                    "year": 2024,
                    "month": 1,
                    "date": 1
                  },
                  {
                    "year": 2025,
                    "month": 1,
                    "date": 1
                  }
                ]
              },
              "scale": {
                "domain": [
                  "2020-12-01",
                  "2027-03-01"
                ]
              }
            },
            "shape": {
              "field": "kind",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Into care",
                  "Rehabilitation step",
                  "Release",
                  "Recaptured",
                  "Other collar signal",
                  "Collar death signal",
                  "Remains found"
                ],
                "range": [
                  "circle",
                  "square",
                  "triangle-up",
                  "diamond",
                  "triangle-down",
                  "M-1,-0.6L-0.6,-1L0,-0.4L0.6,-1L1,-0.6L0.4,0L1,0.6L0.6,1L0,0.4L-0.6,1L-1,0.6L-0.4,0Z",
                  "cross"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "symbolSize": 150,
                "columnPadding": 22,
                "labelLimit": 200
              }
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Into care",
                  "Rehabilitation step",
                  "Release",
                  "Recaptured",
                  "Other collar signal",
                  "Collar death signal",
                  "Remains found"
                ],
                "range": [
                  "#8a8270",
                  "#1b7837",
                  "#D55E00",
                  "#762a83",
                  "#5e6b8a",
                  "#b2182b",
                  "#000000"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "symbolSize": 150,
                "columnPadding": 22,
                "labelLimit": 200
              }
            },
            "yOffset": {
              "field": "nudge",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -1,
                  1
                ],
                "range": [
                  8,
                  30
                ]
              }
            },
            "opacity": {
              "condition": {
                "param": "kindPick",
                "value": 1
              },
              "value": 0.12
            },
            "tooltip": [
              {
                "field": "bear",
                "title": "Bear"
              },
              {
                "field": "event",
                "title": "Event"
              },
              {
                "field": "date_label",
                "title": "Date"
              },
              {
                "field": "place",
                "title": "Place"
              },
              {
                "field": "note",
                "title": "Note"
              },
              {
                "field": "source",
                "title": "Source"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/bear-outcomes.json"
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 16,
            "fontSize": 13,
            "fontStyle": "italic"
          },
          "encoding": {
            "x": {
              "field": "last",
              "type": "temporal",
              "title": null,
              "axis": {
                "format": "%Y",
                "tickCount": {
                  "interval": "year"
                },
                "labelFontSize": 14,
                "labelColor": "#1f2d2a",
                "grid": true
              }
            },
            "text": {
              "field": "outcome"
            },
            "color": {
              "condition": {
                "param": "bearPick",
                "value": "#1f2d2a"
              },
              "value": "#56625d"
            }
          }
        }
      ]
    },
    {
      "width": 860,
      "height": 150,
      "transform": [
        {
          "filter": {
            "param": "bearPick"
          }
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "n"
            }
          ],
          "sort": [
            {
              "field": "date"
            }
          ]
        },
        {
          "calculate": "datum.n % 3",
          "as": "lane"
        },
        {
          "calculate": "[datum.event, datum.date_label]",
          "as": "label"
        }
      ],
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "scale": {
            "padding": 70,
            "nice": false
          },
          "axis": {
            "format": "%-d %b %Y",
            "tickCount": 5,
            "labelFontSize": 13,
            "labelColor": "#1f2d2a",
            "grid": false
          }
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              1
            ]
          },
          "axis": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#1f2d2a",
            "strokeWidth": 2.5
          },
          "encoding": {
            "x": {
              "aggregate": "min",
              "field": "date",
              "type": "temporal"
            },
            "x2": {
              "aggregate": "max",
              "field": "date"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 260,
            "stroke": "#fbf9f2",
            "strokeWidth": 1.5
          },
          "encoding": {
            "shape": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Into care",
                  "Rehabilitation step",
                  "Release",
                  "Recaptured",
                  "Other collar signal",
                  "Collar death signal",
                  "Remains found"
                ],
                "range": [
                  "circle",
                  "square",
                  "triangle-up",
                  "diamond",
                  "triangle-down",
                  "M-1,-0.6L-0.6,-1L0,-0.4L0.6,-1L1,-0.6L0.4,0L1,0.6L0.6,1L0,0.4L-0.6,1L-1,0.6L-0.4,0Z",
                  "cross"
                ]
              },
              "legend": null
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Into care",
                  "Rehabilitation step",
                  "Release",
                  "Recaptured",
                  "Other collar signal",
                  "Collar death signal",
                  "Remains found"
                ],
                "range": [
                  "#8a8270",
                  "#1b7837",
                  "#D55E00",
                  "#762a83",
                  "#5e6b8a",
                  "#b2182b",
                  "#000000"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "bear",
                "title": "Bear"
              },
              {
                "field": "event",
                "title": "Event"
              },
              {
                "field": "date_label",
                "title": "Date"
              },
              {
                "field": "place",
                "title": "Place"
              },
              {
                "field": "note",
                "title": "Note"
              },
              {
                "field": "source",
                "title": "Source"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lane == 0"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -30,
            "fontSize": 12.5,
            "lineHeight": 15,
            "baseline": "bottom"
          },
          "encoding": {
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lane == 1"
            }
          ],
          "mark": {
            "type": "text",
            "dy": 22,
            "fontSize": 12.5,
            "lineHeight": 15,
            "baseline": "top"
          },
          "encoding": {
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lane == 2"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -64,
            "fontSize": 12.5,
            "lineHeight": 15,
            "baseline": "bottom",
            "color": "#56625d"
          },
          "encoding": {
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "k"
                }
              ]
            },
            {
              "filter": "datum.k == 1"
            },
            {
              "calculate": "'Enlarged: ' + datum.bear + ' (click another bear above to switch)'",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 15,
            "fontWeight": 700,
            "color": "#1f2d2a"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": -38
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ],
  "spacing": 56,
  "resolve": {
    "legend": {
      "color": "independent",
      "shape": "independent"
    }
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
