{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Timeline of selected sun bears at BSBCC, 2021-2025: each point is a dated event from the annual reports.",
  "width": "container",
  "height": 400,
  "encoding": {
    "y": {
      "field": "bear",
      "type": "nominal",
      "sort": {
        "field": "order"
      },
      "title": null,
      "axis": {
        "labelFontSize": 15,
        "labelFontWeight": 600,
        "labelColor": "#1f2d2a",
        "labelPadding": 12,
        "grid": true,
        "gridColor": "#efece2"
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/bear-outcomes.json"
      },
      "mark": {
        "type": "rule",
        "color": "#b9b3a0",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "first",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": {
              "interval": "year"
            },
            "labelFontSize": 14,
            "labelColor": "#1f2d2a",
            "grid": true
          }
        },
        "x2": {
          "field": "last"
        }
      }
    },
    {
      "data": {
        "url": "data/bear-journeys.json"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1,
        "stroke": "#fbf9f2",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": {
              "interval": "year"
            },
            "labelFontSize": 14,
            "labelColor": "#1f2d2a",
            "grid": true
          },
          "scale": {
            "domain": [
              "2020-12-01",
              "2027-03-01"
            ]
          }
        },
        "shape": {
          "field": "kind",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Into care",
              "Rehabilitation step",
              "Release",
              "Recaptured",
              "Last news",
              "Death signal"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up",
              "diamond",
              "triangle-down",
              "cross"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolSize": 150,
            "columnPadding": 22,
            "labelLimit": 200
          }
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Into care",
              "Rehabilitation step",
              "Release",
              "Recaptured",
              "Last news",
              "Death signal"
            ],
            "range": [
              "#7f7f7f",
              "#009E73",
              "#E69F00",
              "#D55E00",
              "#56B4E9",
              "#000000"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolSize": 150,
            "columnPadding": 22,
            "labelLimit": 200
          }
        },
        "tooltip": [
          {
            "field": "bear",
            "title": "Bear"
          },
          {
            "field": "event",
            "title": "Event"
          },
          {
            "field": "date",
            "type": "temporal",
            "title": "Date",
            "format": "%d %b %Y"
          },
          {
            "field": "precision",
            "title": "Date precision"
          },
          {
            "field": "place",
            "title": "Place"
          },
          {
            "field": "note",
            "title": "Note"
          },
          {
            "field": "source",
            "title": "Source"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/bear-outcomes.json"
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 16,
        "fontSize": 13,
        "fontStyle": "italic",
        "color": "#56625d"
      },
      "encoding": {
        "x": {
          "field": "last",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": {
              "interval": "year"
            },
            "labelFontSize": 14,
            "labelColor": "#1f2d2a",
            "grid": true
          }
        },
        "text": {
          "field": "outcome"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#56625d",
      "titleColor": "#1f2d2a",
      "domain": false,
      "gridColor": "#e4e0d2",
      "tickColor": "#e4e0d2",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1f2d2a",
      "titleColor": "#1f2d2a",
      "symbolStrokeWidth": 0
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#1f2d2a"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "anchor": "start",
      "color": "#1f2d2a"
    }
  }
}
